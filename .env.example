# Copy this file to .env and fill in your keys:
#   cp .env.example .env
# NEVER commit your actual .env file to Git!

OPENROUTER_API_KEY=sk-or-v1-replace-with-your-key

# Press Pass app (app/server.py reads these from .env)
# Anthropic key for article scoring and summaries: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-replace-with-your-key
# Optional GNews key for extra news search (free tier: 100 searches/day): https://gnews.io
GNEWS_API_KEY=replace-with-your-gnews-key

# Sign-in (Supabase Auth), required. Supabase dashboard → Project Settings → API Keys.
# SUPABASE_URL is the Project URL. SUPABASE_PUBLISHABLE_KEY starts with sb_publishable_
# and is safe in the browser (Row Level Security protects the data).
# Do NOT add the secret key (sb_secret_...): this app doesn't need it.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace-with-your-key

# Exa news search, the main source when set (free plan: $10 of credits a month): https://dashboard.exa.ai
EXA_API_KEY=replace-with-your-exa-key
# NYT Article Search (free; about 5 searches a minute, 500 a day): https://developer.nytimes.com
NYT_API_KEY=replace-with-your-nyt-key
